APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker Compose uses hostname postgres. For host-run API, use localhost.
DATABASE_URL=postgresql://healthcare_app:change_me_local_only@postgres:5432/healthcare
FHIR_BASE_URL=http://fhir:8080/fhir
FHIR_MAX_RESPONSE_BYTES=10485760
FHIR_CAPABILITY_CACHE_SECONDS=60
# Required for FHIR API access; generate a unique local value.
FHIR_API_BEARER_TOKEN=

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=local_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_local_only
MINIO_BUCKET_RAW=healthcare-raw

POSTGRES_DB=healthcare
POSTGRES_USER=healthcare_app
POSTGRES_PASSWORD=change_me_local_only
